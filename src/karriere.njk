---
layout: layout.njk
permalink: karriere.html
title: "Karriere · Raum & Zeit Physiotherapie"
description: "Arbeiten, Hospitation und Entwicklung bei Raum und Zeit Physiotherapie."
currentKey: "karriere"
---
{% from "partials/macros.njk" import figure, head %}
{% set page = copy.karriere %}
{% set heroNum = "05" %}
{% set heroTone = "dark" %}
{% include "partials/page-hero.njk" %}

<section class="image-band" aria-label="Arbeiten bei Raum und Zeit">
  {{ figure(images.karriereWork, "", "rz-figure--bleed rz-figure--band", "eager") }}
</section>

<section class="section" data-reveal-group>
  <div class="shell">
    {{ head(page.values.title, page.values.intro) }}
    {#- Each item reveals its own text directly beneath it; one open at a time. -#}
    <div class="accordion" data-accordion>
      {%- for item in page.values.items %}
      {%- set id = "karriere-" + loop.index %}
      <div class="accordion__item" style="--i: {{ loop.index0 }}">
        <h3 class="accordion__heading">
          <button class="accordion__trigger" type="button" id="{{ id }}-trigger" aria-expanded="false" aria-controls="{{ id }}-panel" data-accordion-trigger>
            <span class="accordion__num">{{ loop.index | nummer }}</span>
            <span class="accordion__title">{{ item.title }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="accordion__panel" id="{{ id }}-panel" role="region" aria-labelledby="{{ id }}-trigger" data-accordion-panel>
          <div class="accordion__inner">{{ item.text | absaetze | safe }}</div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-forest">
  <div class="shell closing">
    <span class="eyebrow">{{ page.contact.kicker }}</span>
    <h2 class="display">{{ page.contact.title }}</h2>
    {{ page.contact.text | absaetze | safe }}
    <a class="button button-light" href="praxis.html#termin">{{ page.contact.button }} <span aria-hidden="true">→</span></a>
  </div>
</section>
