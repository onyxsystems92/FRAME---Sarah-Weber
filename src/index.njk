---
layout: layout.njk
permalink: index.html
title: "Raum & Zeit · Physiotherapie Düsseldorf Oberkassel"
description: "Raum und Zeit: Privatpraxis für Physiotherapie in Düsseldorf Oberkassel. Zeit, funktionelles Denken und persönliche Begleitung."
includeAktuellesCss: true
currentKey: "index"
---
{% from "partials/macros.njk" import figure, headIndex %}

{% include "partials/nav-home.njk" %}

<section class="atmosphere-band" aria-label="Die Praxis">
  {{ figure(images.homeAtmosphere, "", "rz-figure--bleed rz-figure--panorama", "eager") }}
  <div class="atmosphere-band__caption">
    <span>{{ site.addressLine1 }} · {{ site.addressLine2 }}</span>
    <span>{{ copy.home.practiceBand.text }}</span>
  </div>
</section>

{% include "partials/route-grid.njk" %}
{% include "partials/updates-home.njk" %}

<section class="section section-forest" data-reveal-group>
  <div class="shell">
    {{ headIndex(copy.home.treatments.kicker, copy.home.treatments.title, copy.home.treatments.intro) }}
    <nav class="context-index" aria-label="Behandlungskontexte">
      {%- for context in contexts %}
      {%- set item = copy.therapie.contexts[context.anchor] %}
      <a class="context-row" href="therapie.html#{{ context.anchor }}" style="--i: {{ loop.index0 }}">
        <span class="context-row__num">{{ context.num }}</span>
        <span class="context-row__title">{{ item.shortTitle or item.title }}</span>
        <span class="context-row__note">{{ item.summary }}</span>
        <span class="context-row__arrow" aria-hidden="true">→</span>
      </a>
      {%- endfor %}
    </nav>
  </div>
</section>

{% set cta = copy.home.cta %}{% set ctaHref = "praxis.html" %}
{% include "partials/cta-band.njk" %}
