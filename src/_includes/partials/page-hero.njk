{#
  Shared subpage hero. Expects heroKicker, heroNum and optional heroTone
  ("dark") and heroPhoto (an image path from _data/images.yaml). Title and
  intro stay Sarah-editable through _data/copy.yaml.
#}
<section class="page-hero {{ heroTone }}"{% if heroPhoto %} style="--hero-photo: url('{{ heroPhoto }}')"{% endif %}>
  <div class="shell page-hero-grid">
    <div class="page-hero-main">
      <span class="eyebrow">{{ heroKicker }}</span>
      <h1 class="display">{{ copy[currentKey].title | escape }}</h1>
    </div>
    <div class="page-hero-side">
      <p class="lede">{{ copy[currentKey].intro | escape }}</p>
    </div>
    <div class="page-hero-meta" aria-hidden="true">
      <span>{{ heroNum }} / 06</span>
      <span>Raum &amp; Zeit</span>
    </div>
  </div>
</section>
