{% from "partials/macros.njk" import figure %}
{#
  Merged "Was uns prägt" / "Verstehen, bevor behandelt wird." section.
  Binding: the real logo appears here as a restrained accent, and the six
  page cards stay full clickable links in a three-by-two composition.
#}
<section class="section practice-navigation-section">
  <div class="shell">
    <div class="practice-navigation-head">
      <div class="practice-navigation-copy">
        <span class="eyebrow">{{ copy.home.values.kicker }}</span>
        <h2 class="display">{{ copy.home.values.title }}</h2>
        <div class="practice-navigation-context">
          <div class="practice-navigation-logo" aria-hidden="true"><img src="assets/logo-raum-und-zeit.png" alt=""></div>
          {{ copy.home.values.text | absaetze | safe }}
        </div>
      </div>
      <div class="practice-navigation-visual">
        {{ figure(images.homePortrait, "1 / 1", "rz-figure--portrait rz-figure--round") }}
        <div class="practice-navigation-visual__caption"><span>{{ copy.home.values.portraitName }}</span><span>{{ copy.home.values.portraitLine }}</span></div>
      </div>
    </div>

    <nav class="site-route-grid" aria-label="Bereiche von Raum und Zeit">
      {%- for p in pages %}
      <a class="site-route-card" href="{{ p.href }}" style="--i: {{ loop.index0 }}">
        <span class="site-route-card__top"><span class="num">{{ p.num }}</span></span>
        <span class="site-route-card__body">
          <h3>{{ p.title }}</h3>
          <p>{{ copy.home.destinations[p.key] }}</p>
        </span>
      </a>
      {%- endfor %}
    </nav>
  </div>
</section>
