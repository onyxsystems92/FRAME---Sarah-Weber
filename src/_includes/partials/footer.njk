{% from "partials/macros.njk" import mark %}
<footer class="footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="index.html">
          <img class="brand-logo" src="assets/logo-raum-und-zeit.png" alt="" width="32" height="32">
          <span class="brand-wordmark">{{ site.wordmark }}</span>
        </a>
        {{ copy.global.footer.text | absaetze | safe }}
        <div class="footer-mark" aria-hidden="true">{{ mark("footer") }}</div>
      </div>
      <div class="footer-col">
        <h3>Orientierung</h3>
        {%- for p in pages %}{% if p.inNav %}<a href="{{ p.href }}">{{ p.footerLabel }}</a>{% endif %}{% endfor %}
        <a href="aktuelles.html">Aktuelles</a>
      </div>
      <div class="footer-col footer-col--contact">
        <h3>Praxis</h3>
        <a class="footer-phone" href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>
        <span>{{ site.addressLine1 }}<br>{{ site.addressLine2 }}</span>
        <a class="text-link" href="praxis.html#termin">Termin &amp; Kontakt <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Raum &amp; Zeit Physiotherapie</span>
      <span>{{ copy.global.footer.bottomLine }}</span>
    </div>
  </div>
</footer>
