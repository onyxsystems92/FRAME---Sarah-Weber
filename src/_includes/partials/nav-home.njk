{% from "partials/macros.njk" import mark %}
<section class="navigation-home" aria-labelledby="navigation-home-title">
  <div class="nav-home-shell">
    <div class="nav-home-intro">
      <div class="nav-home-kicker"><span class="eyebrow">{{ copy.home.hero.kicker }}</span></div>
      <h1 class="display" id="navigation-home-title">{{ copy.home.hero.title }}</h1>
      {{ copy.home.hero.intro | absaetze | safe }}
    </div>

    <div class="nav-home-router">
      <div class="nav-home-router__motif" aria-hidden="true">{{ mark("router") }}</div>
      <span class="eyebrow">{{ copy.home.orientation.kicker }}</span>
      <h2 class="display">{{ copy.home.orientation.title }}</h2>
      {{ copy.home.orientation.intro | absaetze | safe }}
      <div class="intent-choices" role="group" aria-label="Besucherstatus auswählen">
        {%- for intent in intents %}
        <div class="intent-item">
          <button class="intent-choice" type="button" data-intent-button="{{ intent.key }}"
                  aria-pressed="false" aria-expanded="false" aria-controls="intent-{{ intent.key }}">
            <span class="intent-index">{{ intent.index }}</span>
            <strong>{{ intent.label }}</strong>
            <span class="intent-arrow" aria-hidden="true"></span>
          </button>
          <div class="intent-panel" id="intent-{{ intent.key }}" data-intent-panel="{{ intent.key }}">
            <div class="intent-panel__inner">
              <div class="intent-panel__body">
                <div class="intent-panel-title">{{ intent.panelTitle }}</div>
                <div class="intent-routes">
                  {%- for route in intent.routes %}
                  <a class="intent-route" href="{{ route.href }}" data-intent-route="{{ route.route }}" style="--i: {{ loop.index0 }}">
                    <span>{{ route.label }}</span>
                    <span class="intent-route__arrow" aria-hidden="true">→</span>
                  </a>
                  {%- endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
