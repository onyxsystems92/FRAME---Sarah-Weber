---
layout: layout.njk
permalink: arbeitsweise.html
title: "Wie wir arbeiten · Raum & Zeit Physiotherapie"
description: "Wie Raum und Zeit Physiotherapie mit Zeit, funktionellem Denken und persönlicher Kontinuität arbeitet."
currentKey: "arbeitsweise"
---
{% from "partials/macros.njk" import figure, head, mark %}
{% set page = copy.arbeitsweise %}
{% set heroNum = "01" %}
{% set heroTone = "dark" %}
{% include "partials/page-hero.njk" %}

<div class="fact-strip">
  {%- for fact in page.facts %}
  <div class="fact"><strong>{{ fact.value }}</strong><span>{{ fact.text }}</span></div>
  {%- endfor %}
</div>

<section class="section" data-reveal-group>
  <div class="shell">
    {{ head(page.method.title, page.method.intro) }}
    {#- Steps that follow from each other. The connecting line carries the
        sequence; nothing here is clickable, so nothing pretends to be. -#}
    <ol class="process" aria-label="{{ page.method.steps | join(', ', 'label') }}">
      {%- for step in page.method.steps %}
      <li class="process__step" style="--i: {{ loop.index0 }}">
        <div class="process__marker" aria-hidden="true"><span class="process__num">{{ loop.index | nummer }}</span>{% if not loop.last %}<span class="process__line"></span>{% endif %}</div>
        <span class="process__label">{{ step.label }}</span>
        <h3>{{ step.title }}</h3>
        {{ step.text | absaetze | safe }}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="image-band" aria-label="Behandlung bei Raum und Zeit">
  {{ figure(images.arbeitsweiseHands, "", "rz-figure--bleed rz-figure--band") }}
</section>

<section class="section section-forest" data-reveal-group>
  <div class="shell content-two">
    <div class="sticky-note">
      <div class="time-mark" data-time-mark>{{ mark("time") }}</div>
      <h2 class="display">{{ page.time.title }}</h2>
      {{ page.time.text | absaetze | safe }}
    </div>
    <div class="prose-stack">
      {%- for point in page.time.points %}
      <article class="prose-block">
        <h3>{{ point.title }}</h3>
        {{ point.text | absaetze | safe }}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{% set cta = page.cta %}{% set ctaHref = "therapie.html" %}
{% include "partials/cta-band.njk" %}
