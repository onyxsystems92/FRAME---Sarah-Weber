---
layout: layout.njk
permalink: therapie.html
title: "Therapie · Raum & Zeit Physiotherapie"
description: "Behandlungskontexte und fachliche Orientierung bei Raum und Zeit Physiotherapie."
currentKey: "therapie"
---
{% from "partials/macros.njk" import figure, head, headIndex %}
{% set page = copy.therapie %}
{% set heroNum = "02" %}
{% include "partials/page-hero.njk" %}

<section class="image-band" aria-label="Behandlungssituation">
  {{ figure(images.therapieRoom, "", "rz-figure--bleed rz-figure--band", "eager") }}
</section>

<section class="section" data-reveal-group>
  <div class="shell">
    {{ headIndex(page.contexts.kicker, page.contexts.title, page.contexts.intro) }}
    <div class="details-list">
      {%- for context in contexts %}
      {%- set item = page.contexts[context.anchor] %}
      <details id="{{ context.anchor }}"{% if loop.first %} open{% endif %}>
        <summary><span class="num">{{ context.num }}</span><strong>{{ item.title }}</strong><span class="plus" aria-hidden="true"></span></summary>
        <div class="detail-copy"><div class="detail-copy__inner">{{ item.text | absaetze | safe }}</div></div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-forest" data-reveal-group>
  <div class="shell">
    {{ head(page.methods.title, "", "section-head--wide") }}
    <div class="methods">
      <div class="methods__list">
        <h3 class="methods__title">{{ page.methods.listTitle }}</h3>
        <ol class="method-rows">
          {%- for method in page.methods.items %}
          <li><span class="method-rows__num">{{ loop.index | nummer }}</span><span class="method-rows__name">{{ method.name }}</span></li>
          {%- endfor %}
        </ol>
      </div>
      <aside class="methods__note">
        <h3>{{ page.methods.noteTitle }}</h3>
        {{ page.methods.noteText | absaetze | safe }}
      </aside>
    </div>
  </div>
</section>

{% set cta = page.cta %}{% set ctaHref = "praxis.html" %}
{% include "partials/cta-band.njk" %}
