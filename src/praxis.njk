---
layout: layout.njk
permalink: praxis.html
title: "Praxisbesuch & Termin · Raum & Zeit Physiotherapie"
description: "Kontakt, Termin und organisatorische Informationen für Raum und Zeit Physiotherapie."
currentKey: "praxis"
---
{% from "partials/macros.njk" import figure, head, headIndex %}
{% set page = copy.praxis %}
{% set heroNum = "04" %}
{% include "partials/page-hero.njk" %}

<section class="image-band" aria-label="Ankommen in der Praxis">
  {{ figure(images.praxisEntrance, "", "rz-figure--bleed rz-figure--band", "eager") }}
</section>

<section class="section" id="termin" data-reveal-group>
  <div class="shell">
    {{ headIndex(page.contact.kicker, page.contact.title, page.contact.intro) }}
    <div class="contact-block">
      <div class="contact-block__primary">
        <span class="contact-block__label">Telefon</span>
        <a class="contact-block__phone display" href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>
        {{ page.contact.phoneText | absaetze | safe }}
        {%- if site.appointmentUrlConfirmed and site.appointmentUrl %}
        <div class="contact-block__appointment">
          <span class="contact-block__label">Termin online</span>
          <a class="text-link" href="{{ site.appointmentUrl }}" target="_blank" rel="noopener noreferrer">Online einen Termin vereinbaren <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        {%- endif %}
      </div>
      <div class="contact-block__secondary">
        <div class="contact-block__address">
          <span class="contact-block__label">Adresse</span>
          <address>
            <strong>{{ site.addressLine1 }}</strong><br>
            {{ site.addressLine2 }}
          </address>
          <a class="text-link" href="{{ site.mapsUrl }}" target="_blank" rel="noopener noreferrer">Auf Google Maps öffnen <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        {{ figure(images.praxisRoom, "4 / 3", "rz-figure--inset") }}
      </div>
    </div>
  </div>
</section>

<section class="section section-forest" data-reveal-group>
  <div class="shell">
    {{ head(page.preparation.title) }}
    <dl class="orientation-list">
      {%- for item in page.preparation.items %}
      <div class="orientation-item" style="--i: {{ loop.index0 }}">
        <dt>{{ item.title }}</dt>
        <dd>{{ item.text | absatz(site) | safe }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>

{% set cta = page.cta %}{% set ctaHref = "arbeitsweise.html" %}
{% include "partials/cta-band.njk" %}
