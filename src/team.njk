---
layout: layout.njk
permalink: team.html
title: "Team · Raum & Zeit Physiotherapie"
description: "Team und therapeutische Haltung bei Raum und Zeit Physiotherapie."
currentKey: "team"
---
{% from "partials/macros.njk" import figure, head %}
{% set page = copy.team %}
{% set heroNum = "03" %}
{% set heroTone = "dark page-hero--photo" %}
{% set heroPhoto = images.teamHero.src %}
{% include "partials/page-hero.njk" %}

{%- for member in collections.team %}{% if member.data.featured %}
<section class="section section-tight" data-reveal-group>
  <div class="shell team-feature">
    <div class="team-feature__portrait">
      {{ figure({
        src: member.data.photo,
        alt: member.data.photoAlt or member.data.name,
        focus: "center 25%",
        note: "Portrait " + member.data.name
      }, "1 / 1", "rz-figure--portrait rz-figure--round", "eager") }}
    </div>
    <div class="team-feature__copy">
      <span class="eyebrow">{{ member.data.eyebrow }}</span>
      <h2 class="display">{{ member.data.name }}</h2>
      <div class="team-role">{{ member.data.role }}</div>
      <div class="team-bio">{{ member.templateContent | safe }}</div>
      {%- if member.data.qualifications and member.data.qualifications.length %}
      <div class="qual-list">
        <h3>{{ page.featured.qualificationsTitle }}</h3>
        <ul>{% for q in member.data.qualifications %}<li>{{ q }}</li>{% endfor %}</ul>
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{% endif %}{% endfor -%}

<section class="image-band" aria-label="Einblick in die Praxis">
  {{ figure(images.teamGroup, "", "rz-figure--bleed rz-figure--band") }}
</section>

<section class="section section-forest" data-reveal-group>
  <div class="shell">
    {{ head(page.roster.title, page.roster.intro) }}
    <div class="team-roster">
      {%- for member in collections.team %}{% if not member.data.featured %}
      <article class="roster-entry" style="--i: {{ loop.index0 }}">
        {{ figure({
          src: member.data.photo,
          alt: member.data.photoAlt or member.data.role,
          focus: "center 25%",
          note: "Portrait " + member.data.role
        }, "1 / 1", "rz-figure--portrait") }}
        <div class="roster-entry__copy">
          <h3>{{ member.data.name or member.data.role }}</h3>
          {%- if member.data.name %}<span class="roster-entry__role">{{ member.data.role }}</span>{% endif %}
          {%- if member.templateContent %}<div class="roster-entry__bio">{{ member.templateContent | safe }}</div>{% endif %}
          {%- if member.data.qualifications and member.data.qualifications.length %}
          <ul class="roster-entry__quals" aria-label="Qualifikationen">{% for q in member.data.qualifications %}<li>{{ q }}</li>{% endfor %}</ul>
          {%- endif %}
        </div>
      </article>
      {% endif %}{% endfor -%}
    </div>
  </div>
</section>

{% set cta = page.cta %}{% set ctaHref = "karriere.html" %}
{% include "partials/cta-band.njk" %}
